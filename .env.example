PORT=5000
NODE_ENV=production
JWT_SECRET=sankalp_ai_hackathon_super_secret_key_2026
ALLOWED_ORIGINS=https://sankalp-ai.vercel.app,http://localhost:5173

# Database & Storage
DATABASE_PATH=./server/database/solvelink.db
SANKALP_PERSISTENT_STORAGE=true

# Primary AI Provider (Experiential Labs / GPT-5.6 Luna)
AI_PRIMARY_PROVIDER=experiential
